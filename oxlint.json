{
  "rules": {
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": "error",
    "no-var": "error",
    "prefer-const": "error",
    "semi": "error",
    "quotes": ["error", "single"],
    "indent": ["error", 2],
    "eqeqeq": "error",
    "curly": "error",
    "brace-style": ["error", "1tbs"],
    "keyword-spacing": "error",
    "space-before-function-paren": ["error", {
      "anonymous": "always",
      "named": "never",
      "asyncArrow": "always"
    }],
    "space-infix-ops": "error",
    "object-curly-spacing": ["error", "always"],
    "array-bracket-spacing": ["error", "never"],
    "comma-spacing": "error",
    "no-trailing-spaces": "error",
    "no-multi-spaces": "error"
  },
  "ignorePattern": ["node_modules/", "dist/", "build/", ".angular/", "coverage/"]
}
